#!/usr/bin/env bash
set -e

APP_SOURCE="/usr/share/classification-presse"
APP_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/classification-presse"

prepare_workspace() {
  mkdir -p "$APP_HOME" "$APP_HOME/outputs"

  # Copie le code installé par le paquet dans le dossier de travail utilisateur.
  for item in src config sql requirements.txt README.md LICENSE docs .env.example; do
    rm -rf "$APP_HOME/$item"
    cp -a "$APP_SOURCE/$item" "$APP_HOME/$item"
  done

  if [ ! -f "$APP_HOME/.env" ]; then
    cp "$APP_HOME/.env.example" "$APP_HOME/.env"
  fi
}

setup_runtime() {
  prepare_workspace
  cd "$APP_HOME"

  echo "Configuration de Classification Presse..."

  if [ ! -d .venv ]; then
    python3 -m venv .venv
  fi

  .venv/bin/pip install -r requirements.txt

  if ! .venv/bin/python -c "import spacy; spacy.load('fr_core_news_sm')" >/dev/null 2>&1; then
    .venv/bin/python -m spacy download fr_core_news_sm
  fi

  .venv/bin/python - <<'PY'
import nltk
nltk.download("stopwords", quiet=True)
PY

  echo "Configuration terminée."
}

ensure_runtime() {
  prepare_workspace
  if [ ! -x "$APP_HOME/.venv/bin/python" ]; then
    setup_runtime
  fi
}

run_python() {
  ensure_runtime
  cd "$APP_HOME"
  PYTHONPATH="$APP_HOME/src" "$APP_HOME/.venv/bin/python" "$@"
}

case "${1:-run}" in
  run|interface)
    run_python -m news_classifier.webapp
    ;;
  setup)
    setup_runtime
    ;;
  check)
    run_python -m news_classifier.pipeline check
    ;;
  help|-h|--help)
    echo "Classification Presse"
    echo "  classification-presse        ouvre l'interface"
    echo "  classification-presse setup  installe les dépendances Python"
    echo "  classification-presse check  vérifie l'installation"
    ;;
  *)
    echo "Commande inconnue. Utilisez : classification-presse --help"
    exit 1
    ;;
esac
