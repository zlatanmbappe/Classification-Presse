#!/usr/bin/env bash
set -e
case "${1:-configure}" in
  configure)
    if /usr/sbin/classification-presse-db-setup >/dev/null 2>&1; then
      echo "classification-presse : PostgreSQL configuré."
    else
      echo "classification-presse : PostgreSQL devra être configuré avec :"
      echo "  sudo classification-presse-db-setup"
    fi
    echo "Lancement :"
    echo "  classification-presse"
    ;;
esac
exit 0
