#!/usr/bin/env bash
set -euo pipefail

SCHEMA="/usr/share/classification-presse/sql/01_schema.sql"

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "Cette commande doit être exécutée avec sudo."
  exit 1
fi

if ! command -v psql >/dev/null 2>&1; then
  echo "[ERREUR] PostgreSQL n'est pas installé."
  exit 1
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl start postgresql >/dev/null 2>&1 || true
elif command -v service >/dev/null 2>&1; then
  service postgresql start >/dev/null 2>&1 || true
fi

if ! id postgres >/dev/null 2>&1; then
  echo "[ERREUR] L'utilisateur système postgres est absent."
  exit 1
fi

runuser -u postgres -- psql -v ON_ERROR_STOP=1 -c "ALTER USER postgres PASSWORD 'postgres';"

if ! runuser -u postgres -- psql -tAc "SELECT 1 FROM pg_database WHERE datname='presse'" | grep -qx 1; then
  runuser -u postgres -- createdb presse
fi

runuser -u postgres -- psql -v ON_ERROR_STOP=1 -d presse -f "$SCHEMA"

echo "PostgreSQL : base 'presse' prête."
